# ── Frontend dev server ───────────────────────────────
VITE_PORT=5173

# ── Backend API ───────────────────────────────────────
# Where the game sends API requests. The backend must allow this frontend's
# origin through CORS (CORS_ORIGIN in the backend .env).
VITE_API_BASE_URL=http://localhost:3000

# ── Player ────────────────────────────────────────────
# There is no login yet: every browser plays as this user, created by
# `node prisma/seed.js`.
VITE_PLAYER_USERNAME=detective
