# ── Frontend dev server ───────────────────────────────
VITE_PORT=5173

# ── Backend API ───────────────────────────────────────
# Where the game sends API requests. The backend must allow this frontend's
# origin through CORS (CORS_ORIGIN in the backend .env). The session cookie is
# sent automatically; there is no player name to configure.
VITE_API_BASE_URL=http://localhost:3000
