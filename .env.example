# ── Server ──────────────────────────────────────────────
PORT=3000

# Origin of the game frontend (Vite dev server), allowed by CORS.
# Comma-separate several origins if needed.
CORS_ORIGIN=http://localhost:5173

# ── Sessions ────────────────────────────────────────────
# Long random string. Required in production; a development-only ephemeral
# secret is generated with a warning when this is unset outside production.
# genrate using node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Cookie policy. sameSite=lax blocks cross-site form posts while still working
# for the game's cross-origin requests; set secure=true behind HTTPS.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ── Auth rate limiting ──────────────────────────────────
# Login/registration brute-force protection (per IP, in memory).
# Set DISABLE_AUTH_RATE_LIMIT=true to turn it off (not recommended).
DISABLE_AUTH_RATE_LIMIT=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_MAX=20
AUTH_RATE_LIMIT_REGISTER_MAX=30

# ── SQL IDE database mode ──────────────────────────────
# prisma = the PostgreSQL database below (default and only mode).
# Accepted aliases: postgres, postgresql, pg, real.
DB_MODE=prisma

# ── PostgreSQL connection string (primary) ─────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
